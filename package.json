{
  "name": "tartu-bus-tracker",
  "private": true,
  "version": "3.5.2",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "prebuild": "node scripts/fetchRoutes.js",
    "build": "vite build",
    "build:skip-routes": "vite build",
    "preview": "vite preview",
    "fetch-routes": "node scripts/fetchRoutes.js",
    "android:sync": "npx cap sync android",
    "android:open": "npx cap open android",
    "android:build": "npm run build && npx cap sync android && npx cap open android",
    "android:apk": "npm run build && npx cap sync android && cd android && gradlew assembleDebug",
    "test": "vitest run",
    "lint:i18n": "node scripts/checkLocales.js",
    "check:version": "node scripts/checkVersion.js"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.2",
    "@capacitor/app": "^8.1.1",
    "@capacitor/cli": "^8.5.2",
    "@capacitor/core": "^8.5.2",
    "@emailjs/browser": "^4.4.1",
    "@versatiles/style": "6.4.0",
    "date-fns": "^4.1.0",
    "dotenv": "^17.2.3",
    "i18next": "^25.6.0",
    "maplibre-gl": "6.11.2",
    "polyline-encoded": "^0.0.9",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-i18next": "^16.2.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "autoprefixer": "^10.4.20",
    "gh-pages": "^6.3.0",
    "happy-dom": "^20.14.5",
    "postcss": "^8.4.49",
    "sharp": "^0.34.4",
    "tailwindcss": "^3.4.14",
    "vite": "^5.4.10",
    "vitest": "^3.2.7"
  }
}
